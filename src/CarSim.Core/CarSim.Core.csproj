<Project Sdk="Microsoft.NET.Sdk">
  <!-- Engine-agnostic simulation and domain core. MUST NOT reference Godot. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>CarSim.Core</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Public API docs are encouraged but not enforced on every member yet. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CarSim.Core.Tests" />
  </ItemGroup>
</Project>
